# Copia este archivo como .env.local y completa los valores del proyecto CANCHEA.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor. Nunca uses NEXT_PUBLIC_ ni expongas estos secretos al navegador.
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
CANCHEA_MOCK_WEBHOOK_SECRET=reemplazar_con_un_secreto_largo_y_aleatorio
CANCHEA_PAYMENT_PROVIDER=mock

# Pruebas E2E autenticadas. Define los valores reales sólo en el entorno local o CI.
CANCHEA_TEST_PLAYER_EMAIL=pruebas.jugador@canchea.bo
CANCHEA_TEST_PLAYER_PASSWORD=
CANCHEA_TEST_OWNER_EMAIL=pruebas.propietario@canchea.bo
CANCHEA_TEST_OWNER_PASSWORD=
CANCHEA_TEST_ADMIN_EMAIL=
CANCHEA_TEST_ADMIN_PASSWORD=

# Entrega externa de notificaciones. CRON_SECRET protege /api/notifications/process.
CRON_SECRET=reemplazar_con_un_secreto_largo_y_aleatorio
RESEND_API_KEY=re_reemplazar
CANCHEA_EMAIL_FROM=CANCHEA <reservas@tu-dominio.com>

# Requiere una plantilla aprobada con 3 variables de cuerpo: título, mensaje y URL.
WHATSAPP_ACCESS_TOKEN=reemplazar
WHATSAPP_PHONE_NUMBER_ID=reemplazar
WHATSAPP_API_VERSION=v23.0
WHATSAPP_NOTIFICATION_TEMPLATE=canchea_notification
WHATSAPP_TEMPLATE_LANGUAGE=es

# Actívalo únicamente después de configurar Google en Supabase y Google Cloud.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
